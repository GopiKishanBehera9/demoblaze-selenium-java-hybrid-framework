<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Master Suite" verbose="2">

    <!-- ==========================
         Global Listeners
         ========================== -->
    <listeners>

        <listener class-name="com.demoblaze.listeners.TestListener"/>

    </listeners>

    <!-- ==========================
         Include All Test Suites
         ========================== -->

    <suite-files>

        <suite-file path="testng/testng-smoke.xml"/>
        <suite-file path="testng/testng-sanity.xml"/>
        <suite-file path="testng/testng-regression.xml"/>

    </suite-files>

</suite>